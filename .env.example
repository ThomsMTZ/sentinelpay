# ============================================================================
# SENTINELPAY AI — CONFIGURATION (PayPal AI Hackathon 2026)
# ============================================================================

# 1. PayPal Developer Sandbox Credentials
# Récupérer sur : https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox

# 2. Google Gemini AI Configuration
# Récupérer sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. Budget Guardrails (Default Policy for Agentic Commerce)
DEFAULT_MONTHLY_BUDGET_LIMIT=150.00
DEFAULT_AUTO_APPROVE_THRESHOLD=25.00
DEFAULT_CURRENCY=USD
